{
  "model": "sonnet",
  "effortLevel": "medium",
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "built-in-browser": "off",
    "chrome-browser": "off",
    "computer-use": "off",
    "deep-research": "off",
    "docs": "off",
    "docx": "off",
    "google-workspace": "off",
    "impeccable": "off",
    "import-memory": "off",
    "morning": "off",
    "superpowers:subagent-driven-development": "off",
    "superpowers:writing-skills": "off",
    "superpowers:diagnosing-superpowers": "off",
    "new-project": "off",
    "pdf": "off",
    "pptx": "off",
    "refresh": "off",
    "skill-creator": "off",
    "xlsx": "off"
  },
  "permissions": {
    "allow": [
      "Bash(git fetch:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(node .claude/scripts/branches.mjs:*)",
      "Bash(node .claude/scripts/ledger.mjs next:*)",
      "Bash(node .claude/scripts/ledger.mjs setup:*)",
      "Bash(node --test:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git rebase origin/main)",
      "Bash(git rebase --continue)",
      "Bash(git rebase --abort)",
      "Bash(git worktree add:*)",
      "Bash(node .claude/scripts/build.mjs)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh api:*merge*)",
      "Bash(node .claude/scripts/ledger.mjs land:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout -- :*)",
      "Bash(git checkout:* -- :*)",
      "Bash(git checkout .)",
      "Bash(git checkout -f:*)",
      "Bash(git checkout -B:*)",
      "Bash(git switch -f:*)",
      "Bash(git switch --discard-changes:*)",
      "Bash(git switch -C:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(rm -rf:*)"
    ],
    "deny": [
      "Edit(/index.html)",
      "Edit(/league.html)",
      "Edit(/inseason.html)",
      "Edit(/settings.html)",
      "Edit(/rankings.html)",
      "Edit(/team.html)",
      "Edit(/math.html)",
      "Read(/src/logs*.csv)",
      "Read(/src/bt_daily.json)",
      "Read(/src/bt_data.json)",
      "Read(/src/bt_*_*.json)",
      "Read(/src/data/*.xls*)",
      "Read(/index.html)",
      "Read(/league.html)",
      "Read(/inseason.html)",
      "Read(/settings.html)",
      "Read(/rankings.html)",
      "Read(/team.html)",
      "Read(/math.html)",
      "Read(**/node_modules/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/branches.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/before-bash.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/before-edit.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit.mjs\"",
            "timeout": 150
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/context-stop.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/context-warn.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$(git rev-parse --show-toplevel)/.claude/statusline.mjs\""
  }
}
