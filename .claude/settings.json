{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash",
      "PowerShell",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "Bash(git fetch:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(node .claude/scripts/branches.mjs:*)",
      "Bash(node .claude/scripts/ledger.mjs next:*)",
      "Bash(node .claude/scripts/ledger.mjs setup:*)",
      "Bash(node --test:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git rebase origin/main)",
      "Bash(git rebase --continue)",
      "Bash(git rebase --abort)",
      "Bash(git worktree add:*)",
      "Bash(node .claude/scripts/build.mjs)",
      "Bash(git pull --ff-only:*)",
      "Bash(git merge:*)",
      "Bash(git worktree remove:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr create:*)",
      "Bash(git -C C:/Users/Fefe/Documents/FantasyBBall-ledger status -sb)",
      "Bash(git -C C:/Users/Fefe/Documents/FantasyBBall-ledger log --oneline -2)",
      "Read(//c/Users/Fefe/Documents/FantasyBBall-*/**)",
      "Bash(git -C C:/Users/Fefe/Documents/FantasyBBall-ledger commit -qam \"docs: handoff, PRs #45 merged, #46 open, permissions state\" -m \"Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>\")",
      "Bash(git -C C:/Users/Fefe/Documents/FantasyBBall-ledger log --oneline -1)",
      "Bash(node .claude/scripts/branches.mjs)",
      "Bash(git ls-tree *)",
      "Bash(git worktree *)",
      "Bash(node --test C:/Users/Fefe/Documents/FantasyBBall-tests/src/tests/)"
    ],
    "deny": [
      "Edit(/index.html)",
      "Edit(/league.html)",
      "Edit(/inseason.html)",
      "Edit(/settings.html)",
      "Edit(/rankings.html)",
      "Edit(/team.html)",
      "Edit(/math.html)",
      "Read(/src/logs*.csv)",
      "Read(/src/bt_daily.json)",
      "Read(/src/bt_data.json)",
      "Read(/src/bt_*_*.json)",
      "Read(/src/data/*.xls*)",
      "Read(/index.html)",
      "Read(/league.html)",
      "Read(/inseason.html)",
      "Read(/settings.html)",
      "Read(/rankings.html)",
      "Read(/team.html)",
      "Read(/math.html)",
      "Read(**/node_modules/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh api:*merge*)",
      "Bash(git -C * push *)",
      "Bash(rm *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git worktree remove *)",
      "PowerShell(git push:*)",
      "PowerShell(gh pr merge:*)",
      "PowerShell(Remove-Item *)"
    ],
    "additionalDirectories": [
      "C:\\Users\\Fefe\\AppData\\Local\\Temp\\claude\\cw\\template",
      "C:\\Users\\Fefe\\Documents\\FantasyBBall-ledger\\src"
    ]
  },
  "model": "sonnet",
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "built-in-browser": "off",
    "chrome-browser": "off",
    "computer-use": "off",
    "deep-research": "off",
    "docs": "off",
    "docx": "off",
    "google-workspace": "off",
    "impeccable": "off",
    "import-memory": "off",
    "morning": "off",
    "superpowers:subagent-driven-development": "off",
    "superpowers:writing-skills": "off",
    "superpowers:diagnosing-superpowers": "off",
    "new-project": "off",
    "pdf": "off",
    "pptx": "off",
    "refresh": "off",
    "skill-creator": "off",
    "xlsx": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/branches.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/before-bash.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-ask.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/before-edit.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit.mjs\"",
            "timeout": 150
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/context-stop.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/context-warn.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$(git rev-parse --show-toplevel)/.claude/statusline.mjs\""
  },
  "effortLevel": "medium"
}
