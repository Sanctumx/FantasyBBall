{
  "model": "sonnet",
  "effortLevel": "medium",
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "built-in-browser": "off",
    "chrome-browser": "off",
    "computer-use": "off",
    "deep-research": "off",
    "docs": "off",
    "docx": "off",
    "google-workspace": "off",
    "impeccable": "off",
    "import-memory": "off",
    "morning": "off",
    "superpowers:subagent-driven-development": "off",
    "superpowers:writing-skills": "off",
    "superpowers:diagnosing-superpowers": "off",
    "new-project": "off",
    "pdf": "off",
    "pptx": "off",
    "refresh": "off",
    "skill-creator": "off",
    "xlsx": "off"
  },
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh api:*merge*)"
    ],
    "deny": [
      "Edit(/index.html)",
      "Edit(/league.html)",
      "Edit(/inseason.html)",
      "Edit(/settings.html)",
      "Edit(/rankings.html)",
      "Edit(/team.html)",
      "Edit(/math.html)",
      "Read(/src/logs*.csv)",
      "Read(/src/bt_daily.json)",
      "Read(/src/bt_data.json)",
      "Read(/src/bt_*_*.json)",
      "Read(/src/data/*.xls*)",
      "Read(/index.html)",
      "Read(/league.html)",
      "Read(/inseason.html)",
      "Read(/settings.html)",
      "Read(/rankings.html)",
      "Read(/team.html)",
      "Read(/math.html)",
      "Read(**/node_modules/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/before-edit.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit.mjs\"",
            "timeout": 150
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/context-stop.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/context-warn.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$(git rev-parse --show-toplevel)/.claude/statusline.mjs\""
  }
}
