// Cloudflare Workers config for the Courtside Draft Kit (runs alongside Netlify until the switch).
// Connect the GitHub repo in Cloudflare: Workers & Pages → Create → Import a repository; no build command needed.
{
  "name": "courtside-basketball",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // Serves the repo root (index.html) as static assets; .assetsignore keeps everything else out
  "assets": { "directory": ".", "binding": "ASSETS" }
}
